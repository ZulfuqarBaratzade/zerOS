# REVIEW ONLY: not loaded. Candidate build policy; needs separate approval.
# Based on Moby's AppArmor template (Apache-2.0); not a byte copy of the daemon profile.
#include <tunables/global>
profile zeros-build flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  file,
  network,
  capability chown,
  capability dac_override,
  capability fowner,
  capability fsetid,
  capability setuid,
  capability setgid,
  capability setfcap,
  capability mknod,
  capability sys_admin,
  capability sys_chroot,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=zeros-build,
  ptrace (trace,tracedby,read,readby) peer=zeros-build,
  # Only build-volume mount targets are allowed. No extra host devices mapped.
  mount fstype=tmpfs -> /work/**,
  mount fstype=proc -> /work/**,
  mount fstype=sysfs -> /work/**,
  mount fstype=devpts -> /work/**,
  mount options in (bind, rbind, remount, ro, rw, private, rprivate, slave, rslave) -> /work/**,
  umount /work/**,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
