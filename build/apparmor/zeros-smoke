# REVIEW ONLY: not loaded. Default-like Docker restrictions with one tmpfs target.
# Based on Moby's AppArmor template (Apache-2.0); not a byte copy of the daemon profile.
#include <tunables/global>
profile zeros-smoke flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  file,
  network,
  capability sys_admin,
  capability sys_chroot,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=zeros-smoke,
  ptrace (trace,tracedby,read,readby) peer=zeros-smoke,
  # Unlisted mounts are denied. No block filesystem/host mount permission.
  mount fstype=tmpfs -> /scratch/probe/,
  umount /scratch/probe/,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
